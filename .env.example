DB_NAME=model_hub
DB_USERNAME=postgres
DB_PASSWORD=PASSWORD
# Default sslmode when DB_SSL_MODE isn't set. Not read by compose.dev.yaml (no
# db-side SSL support yet) or compose.prod.yaml (prod hardcodes DB_SSL_MODE=require).
DB_SSL_MODE=disable

# cert/key for the db service (production only). Run db/generate-cert.sh to
# create a self-signed pair - the CN must be "db" to match the Compose service name.
# Example path: ./certs/db/server.crt or ./certs/db/server.key
DB_SSL_CRT_PATH=PATH/TO/CRT
DB_SSL_KEY_PATH=PATH/TO/KEY

# use below for local development, otherwise use prod url without port with /api/
API_URL=http://localhost:8080

JWT_SECRET=SECRET
GOOGLE_CLIENT_ID=CLIENT_ID
GOOGLE_CLIENT_SECRET=CLIENT_SECRET

# use below for local development, otherwise use prod url without port
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/callback

# nginx ssl config for prod
# Example path: ./certs/nginx/server.crt or ./certs/nginx/server.key
# In prod these will likely be absolute paths
SSL_CRT_PATH=PATH/TO/CRT
SSL_KEY_PATH=PATH/TO/KEY
